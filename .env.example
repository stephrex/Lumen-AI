# ---------------------------------------------------------------------------
# LUMEN environment configuration
# Copy this file to `.env.local` and fill in what you need. All cloud keys are
# SERVER-SIDE ONLY — never prefixed with NEXT_PUBLIC, so they never reach the
# browser. The app runs fine with none of these set (labelled Demo mode).
# ---------------------------------------------------------------------------

# --- Cloud fallback (optional) ---
# Choose a provider explicitly, or leave blank to auto-pick from whichever key exists.
#   anthropic | gemini
GEMMA_PROVIDER=

# Anthropic (Claude) — has vision. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini — has vision. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override the model id if you like (defaults: claude-sonnet-5 / gemini-2.5-flash)
GEMMA_MODEL=
GEMMA_BASE_URL=

# --- On-device Gemma (optional, browser/WebGPU) ---
# A browser-optimised Gemma build (a *-web.task GPU file). The weights download
# to the user's device at runtime and are NOT bundled or deployed to the server.
# Accept the Gemma licence on Hugging Face, then point this at the file URL.
NEXT_PUBLIC_GEMMA_MODEL_URL=
NEXT_PUBLIC_GEMMA_MODEL_NAME=Gemma 3 1B (web)
NEXT_PUBLIC_GEMMA_MODEL_MB=550
# WASM runtime for MediaPipe GenAI (defaults to the jsDelivr CDN build).
# NEXT_PUBLIC_MEDIAPIPE_WASM=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-genai/wasm
